{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Bump the oryn modules used by other oryn modules together, right after a release",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/go-oryn/oryn/**"],
      "groupName": "oryn modules",
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    },
    {
      "description": "OpenTelemetry Go packages are released together",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["go.opentelemetry.io/**"],
      "groupName": "opentelemetry"
    },
    {
      "description": "Keep the go directive and toolchain under manual control",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "enabled": false
    }
  ]
}
